CAPI=2:
name: local:ibex:ihp_fullchip:1.0
filesets:
  rtl:
    depend: [lowrisc:ibex:ibex_top]
    files:
      - rtl/ihp_sram_1kx32.sv
      - rtl/ibex_soc.sv
      - rtl/chip_top.sv
    file_type: systemVerilogSource
targets:
  default:
    filesets: [rtl]
    toplevel: chip_top
  lint:
    filesets: [rtl]
    toplevel: chip_top
    default_tool: verilator
    tools:
      verilator:
        mode: lint-only
        verilator_options: [--Wall, -Wno-fatal, -DSYNTHESIS]
